{
  "name": "claude-usage",
  "displayName": "Claude Usage",
  "description": "Shows Claude plan usage (session / weekly) in the status bar. Unofficial; not affiliated with Anthropic.",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zianazari/claude-usage-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeUsage.refresh",
        "title": "Claude Usage: Refresh"
      }
    ],
    "configuration": {
      "title": "Claude Usage",
      "properties": {
        "claudeUsage.refreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How often to refresh usage (minutes)."
        }
      }
    }
  }
}
